{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Rendobar",
  "theme": "mint",
  "colors": {
    "primary": "#34d399",
    "light": "#6ee7b7",
    "dark": "#10b981"
  },
  "background": {
    "color": {
      "dark": "#08090a",
      "light": "#ffffff"
    }
  },
  "logo": {
    "dark": "https://cdn.rendobar.com/assets/brand/logo-mark.svg",
    "light": "https://cdn.rendobar.com/assets/brand/logo-mark-black.svg",
    "href": "https://rendobar.com"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/job",
              "guides/webhooks",
              "guides/callbacks"
            ]
          },
          {
            "group": "Jobs",
            "pages": [
              "jobs/ffmpeg",
              "jobs/ffprobe",
              "jobs/compose",
              {
                "group": "Captions",
                "icon": "closed-captioning",
                "pages": [
                  "jobs/captions/animate",
                  "jobs/captions/burn"
                ]
              }
            ]
          },
          {
            "group": "Integrations",
            "icon": "puzzle-piece",
            "pages": [
              "sdk",
              "cli",
              "mcp-server",
              "n8n"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "support/faq",
              "concepts/credits",
              "support/limits",
              "support/errors"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.rendobar.com",
          "icon": "gauge"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/rendobar",
          "icon": "github"
        }
      ]
    }
  },
